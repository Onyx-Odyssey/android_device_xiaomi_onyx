<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.lineageos.settings"
    android:versionCode="1"
    android:versionName="1.0"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <protected-broadcast android:name="com.android.systemui.doze.pulse" />

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="30" />

    <application
        android:label="@string/app_title"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:replace="android:authorities" />

        <receiver
            android:name=".Startup"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ApplyOnBootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Onyx Parts -->
        <activity
            android:name=".onyxparts.OnyxPartsActivity"
            android:label="@string/onyx_parts_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/onyx_parts_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/onyx_parts_summary" />
            <meta-data
        	    android:name="com.android.settings.icon"
        	    android:resource="@drawable/ic_onyx" />
        	<meta-data
                android:name="com.android.settings.order"
                android:value="-1000000" />
        </activity>

        <!-- Device Extras -->
        <activity
            android:name=".deviceextras.DeviceExtrasActivity"
            android:label="@string/device_extras_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/device_extras_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/device_extras_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_device" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-999999" />
        </activity>

        <!-- Display color mode service (onyx displayfeature HAL) -->
        <service
            android:name="com.xiaomi.settings.display.ColorService"
            android:permission="ColorService"
            android:exported="false" />

        <!-- Thermal Settings -->
        <activity
            android:name=".thermal.ThermalComposeActivity"
            android:label="@string/thermal_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true" />
            
        <service
            android:name=".thermal.ThermalService"
            android:permission="ThermalService">
        </service>
            


        <!-- Core Control -->
        <activity
            android:name=".corecontrol.CoreControlActivity"
            android:label="@string/core_control_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />

        <!-- Clear Speaker -->
        <activity
            android:name=".speaker.ClearSpeakerActivity"
            android:label="@string/clear_speaker_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />
        
        <!-- CPU Control -->
        <activity
            android:name=".kernelmanager.KernelManagerActivity"
            android:label="@string/kernel_manager_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />

        <!-- GPU Control -->
        <activity
            android:name=".gpumanager.GpuManagerActivity"
            android:label="@string/gpu_manager_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />

        <!-- Display Saturation activity -->
        <activity
            android:name=".saturation.SaturationActivity"
            android:label="@string/saturation_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />

        <!-- Display Saturation tile service -->
        <service
            android:name=".saturation.SaturationTileService"
            android:label="@string/saturation_title"
            android:icon="@drawable/ic_saturation_tile"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Thermal Limiter app picker -->
        <activity
            android:name=".deviceextras.ThermalAppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/thermal_limiter_apps_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Thermal Limiter tile service -->
        <service
            android:name=".thermallimiter.ThermalLimiterTileService"
            android:label="@string/thermal_limiter_title"
            android:icon="@drawable/ic_thermal"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- USB-OTG tile service -->
        <service
            android:name=".otg.OTGTileService"
            android:label="@string/otg_mode_title"
            android:icon="@drawable/ic_otg_mode"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
