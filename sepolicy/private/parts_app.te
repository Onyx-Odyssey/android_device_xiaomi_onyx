type parts_app, domain;
typeattribute parts_app mlstrustedsubject;

app_domain(parts_app)

allow parts_app activity_service:service_manager find;
allow parts_app activity_task_service:service_manager find;
allow parts_app audio_service:service_manager find;
allow parts_app netstats_service:service_manager find;
allow parts_app vendor_hal_displayfeature_xiaomi_service:service_manager find;
binder_call(parts_app, vendor_hal_displayfeature_xiaomi_default)

allow parts_app system_app_data_file:dir create_dir_perms;
allow parts_app system_app_data_file:file create_file_perms;
allow parts_app system_app_data_file:lnk_file create_file_perms;

# SurfaceFlinger saturation control (Startup receiver + SaturationActivity)
allow parts_app surfaceflinger_service:service_manager find;
binder_call(parts_app, surfaceflinger)

# CPU core control and cpufreq (Core Control, Kernel Manager)
allow parts_app sysfs_devices_system_cpu:dir search;
allow parts_app sysfs_devices_system_cpu:file rw_file_perms;
allow parts_app sysfs_devices_system_cpu:lnk_file read;

# GPU (KGSL) control and telemetry (GPU Manager)
allow parts_app vendor_sysfs_kgsl:dir r_dir_perms;
allow parts_app vendor_sysfs_kgsl:file rw_file_perms;
allow parts_app vendor_sysfs_kgsl:lnk_file r_file_perms;
allow parts_app vendor_sysfs_kgsl_gpuclk:file rw_file_perms;

# Thermal profiles via /sys/class/thermal/thermal_message/sconfig
allow parts_app sysfs_thermal:dir search;
allow parts_app sysfs_thermal:file rw_file_perms;