# FPS info
allow platform_app vendor_sysfs_graphics:dir search;
allow platform_app vendor_sysfs_graphics:file r_file_perms;

# NotGameTurbo (com.grewal.notgamemode) writes the sysfs_thermal scenario node.
allow platform_app sysfs_thermal:dir search;
allow platform_app sysfs_thermal:file rw_file_perms;