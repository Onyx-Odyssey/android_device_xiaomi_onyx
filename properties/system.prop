# Bluetooth
persist.vendor.btstack.enable.twsplus=true
persist.vendor.btstack.enable.twsplussho=true

# CameraX
ro.camerax.extensions.enabled=true

# CNE
persist.vendor.cne.feature=1

# Device
ro.product.marketname=POCO F7
ro.product.mod_device=onyx_global

# GPS
persist.backup.ntpServer=0.pool.ntp.org

# GPU
ro.qcom.adreno.qgl.ShaderStorageImageExtendedFormats=0

# HWUI
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
ro.hwui.render_ahead=30
ro.hwui.drop_shadow_cache_size=6
ro.hwui.gradient_cache_size=1
ro.hwui.layer_cache_size=48
ro.hwui.path_cache_size=32
ro.hwui.r_buffer_cache_size=8
ro.hwui.text_large_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_small_cache_height=1024
ro.hwui.text_small_cache_width=1024
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.texture_cache_size=72
renderthread.skia.reduceopstasksplitting=true

# Input
ro.max.fling_velocity=20000
ro.min.fling_velocity=160

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
media.settings.xml=/vendor/etc/media_profiles_tuna_v0.xml
ro.mediaserver.64b.enable=true
ro.media.recorder-max-base-layer-fps=60
ro.media.xml_variant.profiles=_tuna_v0

# QTI
ro.vendor.qti.va_aosp.support=1

# Radio
persist.vendor.data.mode=concurrent
ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1

# Radio VoNR Calling
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true
persist.vendor.vonr_setting_support=1

# WFD
persist.debug.wfd.enable=1
